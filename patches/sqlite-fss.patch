+/*
+** Routines for Fixed-Schema Storage (FSS) leaf pages (0x0E).
+*/
+u8 *fssFindCell(MemPage *pPage, int iCell){
+  u8 *data = pPage->aData + pPage->hdrOffset;
+  u16 dataAreaOffset = get2byte(&data[12]);
+  u16 rowPayloadSize = get2byte(&data[8]);
+  return data + dataAreaOffset + (iCell * rowPayloadSize);
+}
+
+u16 fssCellSizePtr(MemPage *pPage, u8 *pCell){
+  (void)pCell;
+  u8 *data = pPage->aData + pPage->hdrOffset;
+  return get2byte(&data[8]);
+}
+
+i64 fssGetRowid(MemPage *pPage, int iCell){
+  u8 *data = pPage->aData + pPage->hdrOffset;
+  u8 flags = data[1];
+  u16 nCols = get2byte(&data[16]);
+  u16 descSize = 2 + nCols * 4;
+  if( flags & 0x01 ){ /* FSS_FLAG_DENSE_ROWID */
+    u8 *pMin = &data[16 + descSize];
+    u64 v = 0;
+    int i;
+    for( i=0; i<8; i++ ){ v = (v<<8) | pMin[i]; }
+    return (i64)v + iCell;
+  }else{
+    u8 *pRid = &data[16 + descSize + iCell * 8];
+    u64 v = 0;
+    int i;
+    for( i=0; i<8; i++ ){ v = (v<<8) | pRid[i]; }
+    return (i64)v;
+  }
+}
+
+void btreeParseCellPtrFss(MemPage *pPage, u8 *pCell, CellInfo *pInfo){
+  u8 *data = pPage->aData + pPage->hdrOffset;
+  u16 rowPayloadSize = get2byte(&data[8]);
+  u16 dataAreaOffset = get2byte(&data[12]);
+  int iCell = 0;
+  if( rowPayloadSize>0 ){
+    iCell = (int)((pCell - (data + dataAreaOffset)) / rowPayloadSize);
+  }
+
+  pInfo->nKey = fssGetRowid(pPage, iCell);
+  pInfo->pPayload = pCell;
+  pInfo->nPayload = rowPayloadSize;
+  pInfo->nLocal = rowPayloadSize;
+  pInfo->nSize = rowPayloadSize;
+}
 
