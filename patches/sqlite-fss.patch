+void fssExtractColumn(MemPage *pPage, const u8 *pSlot, int iCol, Mem *pDest){
+  u8 *data = pPage->aData + pPage->hdrOffset;
+  u8 flags = data[1];
+  u16 nCols = get2byte(&data[16]);
+  u16 nullBytes = (flags & 0x02) ? ((nCols + 7) / 8) : 0;
+  int i;
+  u16 offset = 0;
+  if( iCol < 0 || iCol >= nCols ){
+    sqlite3VdbeMemSetNull(pDest);
+    return;
+  }
+  if( nullBytes > 0 ){
+    if( pSlot[iCol / 8] & (1 << (iCol % 8)) ){
+      sqlite3VdbeMemSetNull(pDest);
+      return;
+    }
+  }
+  for( i = 0; i < iCol; i++ ){
+    u8 *desc = &data[18 + i * 4];
+    offset += get2byte(&desc[2]);
+  }
+  u8 *desc = &data[18 + iCol * 4];
+  u8 type_id = desc[0];
+  u16 width = get2byte(&desc[2]);
+  const u8 *pSrc = pSlot + nullBytes + offset;
+  switch( type_id ){
+    case 0x01: { /* INT8 / BOOL */
+      pDest->flags = MEM_Int;
+      pDest->u.i = (signed char)*pSrc;
+      break;
+    }
+    case 0x02: { /* INT16 */
+      pDest->flags = MEM_Int;
+      pDest->u.i = (i16)get2byte(pSrc);
+      break;
+    }
+    case 0x03: { /* INT32 */
+      pDest->flags = MEM_Int;
+      pDest->u.i = (int)get4byte(pSrc);
+      break;
+    }
+    case 0x04:
+    case 0x08: { /* INT64 / TIMESTAMP */
+      u64 v = 0;
+      for( i=0; i<8; i++ ) v = (v<<8) | pSrc[i];
+      pDest->flags = MEM_Int;
+      pDest->u.i = (i64)v;
+      break;
+    }
+    case 0x05: { /* FLOAT32 */
+      u32 u = get4byte(pSrc);
+      float f;
+      memcpy(&f, &u, 4);
+      pDest->flags = MEM_Real;
+      pDest->u.r = (double)f;
+      break;
+    }
+    case 0x06: { /* FLOAT64 */
+      u64 u = 0;
+      for( i=0; i<8; i++ ) u = (u<<8) | pSrc[i];
+      double d;
+      memcpy(&d, &u, 8);
+      pDest->flags = MEM_Real;
+      pDest->u.r = d;
+      break;
+    }
+    case 0x07: { /* FIXED_BLOB */
+      sqlite3VdbeMemSetStr(pDest, (const char*)pSrc, width, 0, SQLITE_TRANSIENT);
+      break;
+    }
+    case 0x0A: { /* TEXT */
+      sqlite3VdbeMemSetStr(pDest, (const char*)pSrc, width, SQLITE_UTF8, SQLITE_TRANSIENT);
+      break;
+    }
+    default: {
+      sqlite3VdbeMemSetNull(pDest);
+      break;
+    }
+  }
+}
