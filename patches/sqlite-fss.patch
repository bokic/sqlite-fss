+      int j;
+      for( j=5; j<len-1; j++ ){
+        if( zType[j]<'0' || zType[j]>'9' ){ k = 0; break; }
+        k = k*10 + (zType[j]-'0');
+        if( k > 65535 ){ k = 0; break; }
+      }
+      if( k <= 0 ) return 0;
+      type_id = FSS_TYPE_FIXED_BLOB;
+      width = k;
+    }else{
+      return 0;
+    }
