+    aCols[i].type_id = (uint8_t)type_id;
+    aCols[i].byte_width = (uint16_t)width;
+    aCols[i].col_flags = 0;
+    if( pCol->notNull ){
+      aCols[i].col_flags |= FSS_COL_FLAG_NOT_NULL;
+    }else{
+      hasNullable = 1;
+    }
+  }
