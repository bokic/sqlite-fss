+  int i;
+  int hasNullable = 0;
+  if( pTab==0 ) return 0;
+  if( !HasRowid(pTab) ) return 0;
+  if( pTab->iPKey >= 0 ) return 0;
+  if( pTab->tabFlags & TF_HasVirtual ) return 0;
+  if( IsVirtual(pTab) ) return 0;
+  if( pTab->nCol <= 0 || pTab->nCol > FSS_MAX_COLUMNS ) return 0;
+
