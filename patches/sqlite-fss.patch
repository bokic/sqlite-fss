+/*
+** Routines for Fixed-Schema Storage (FSS) leaf pages (0x0E).
+*/
+u8 *fssFindCell(MemPage *pPage, int iCell){
+  u8 *data = pPage->aData + pPage->hdrOffset;
+  u16 dataAreaOffset = get2byte(&data[FSS_HDR_DATA_AREA_OFFSET]);
+  u16 rowPayloadSize = get2byte(&data[FSS_HDR_ROW_PAYLOAD_SIZE]);
+  return data + dataAreaOffset + (iCell * rowPayloadSize);
+}
+
+u16 fssCellSizePtr(MemPage *pPage, u8 *pCell){
+  (void)pCell;
+  u8 *data = pPage->aData + pPage->hdrOffset;
+  return get2byte(&data[FSS_HDR_ROW_PAYLOAD_SIZE]);
+}
+
+i64 fssGetRowid(MemPage *pPage, int iCell){
+  u8 *data = pPage->aData + pPage->hdrOffset;
+  u8 flags = data[FSS_HDR_FLAGS];
+  u16 fieldDescOffset = get2byte(&data[FSS_HDR_FIELD_DESC_OFFSET]);
+  u16 nCols = get2byte(&data[fieldDescOffset + FSS_SCHEMA_NUM_COLUMNS]);
+  u16 descSize = FSS_SCHEMA_HEADER_SIZE + nCols * FSS_FIELD_DESC_SIZE;
+  u8 *pIndex = data + fieldDescOffset + descSize;
+  if( flags & FSS_FLAG_DENSE_ROWID ){
+    return fssGetI64(pIndex) + iCell;
+  }else{
+    return fssGetI64(pIndex + iCell * 8);
+  }
+}
+
+void btreeParseCellPtrFss(MemPage *pPage, u8 *pCell, CellInfo *pInfo){
+  u8 *data = pPage->aData + pPage->hdrOffset;
+  u16 rowPayloadSize = get2byte(&data[FSS_HDR_ROW_PAYLOAD_SIZE]);
+  u16 dataAreaOffset = get2byte(&data[FSS_HDR_DATA_AREA_OFFSET]);
+  u8 *pDataStart = data + dataAreaOffset;
+  u8 *pDataEnd = pDataStart + (u32)pPage->nCell * rowPayloadSize;
+
+  if( pCell >= pDataStart && pCell < pDataEnd && rowPayloadSize > 0 ){
+    int iCell = (int)((pCell - pDataStart) / rowPayloadSize);
+    pInfo->nKey = fssGetRowid(pPage, iCell);
+    pInfo->pPayload = pCell;
+    pInfo->nPayload = rowPayloadSize;
+    pInfo->nLocal = rowPayloadSize;
+    pInfo->nSize = rowPayloadSize;
+  }else{
+    /* Overflow cell: 8 bytes big-endian rowid followed by payload */
+    pInfo->nKey = (i64)fssGetI64(pCell);
+    pInfo->pPayload = pCell + 8;
+    pInfo->nPayload = rowPayloadSize;
+    pInfo->nLocal = rowPayloadSize;
+    pInfo->nSize = 8 + rowPayloadSize;
+  }
+}
+
+int sqlite3FssValidateDbMarker(const u8 *aDbHdr, u32 *pVersion){
+  const u8 *p;
+  u32 ver;
+  int allZero = 1;
+  int i;
+
+  if( !aDbHdr ) return FSS_MARKER_INVALID;
+  p = aDbHdr + FSS_DB_MARKER_OFFSET;
+
+  for( i = 0; i < FSS_DB_MARKER_SIZE; i++ ){
+    if( p[i] != 0 ){
+      allZero = 0;
+      break;
+    }
+  }
+  if( allZero ){
+    if( pVersion ) *pVersion = 0;
+    return FSS_MARKER_NONE;
+  }
+
+  if( memcmp(p, FSS_DB_MAGIC, FSS_DB_MAGIC_SIZE) == 0 ){
+    ver = ((u32)p[4] << 24) |
+          ((u32)p[5] << 16) |
+          ((u32)p[6] << 8)  |
+          ((u32)p[7]);
+    if( pVersion ) *pVersion = ver;
+    if( ver == FSS_DB_VERSION ){
+      return FSS_MARKER_VALID;
+    }else{
+      return FSS_MARKER_UNSUPPORTED_VER;
+    }
+  }
+
+  if( pVersion ) *pVersion = 0;
+  return FSS_MARKER_INVALID;
+}
+
+int sqlite3FssWriteDbMarker(u8 *aDbHdr, u32 version){
+  u8 *p;
+  if( !aDbHdr ) return SQLITE_ERROR;
+  p = aDbHdr + FSS_DB_MARKER_OFFSET;
+  memcpy(p, FSS_DB_MAGIC, FSS_DB_MAGIC_SIZE);
+  p[4] = (u8)((version >> 24) & 0xFF);
+  p[5] = (u8)((version >> 16) & 0xFF);
+  p[6] = (u8)((version >> 8) & 0xFF);
+  p[7] = (u8)(version & 0xFF);
+  return SQLITE_OK;
+}
+
+int sqlite3BtreeMarkFss(BtShared *pBt){
+  int rc;
+  assert( sqlite3_mutex_held(pBt->mutex) );
+  if( pBt->pPage1==0 ) return SQLITE_OK;
+  if( (pBt->btsFlags & BTS_FSS)!=0 ){
+    return SQLITE_OK;
+  }
+  rc = sqlite3PagerWrite(pBt->pPage1->pDbPage);
+  if( rc==SQLITE_OK ){
+    sqlite3FssWriteDbMarker(pBt->pPage1->aData, FSS_DB_VERSION);
+    pBt->btsFlags |= BTS_FSS;
+  }
+  return rc;
+}
+
+int sqlite3BtreeSetFssFormat(Btree *p, u32 version){
+  BtShared *pBt;
+  int rc;
+  if( p==0 ) return SQLITE_MISUSE;
+  sqlite3BtreeEnter(p);
+  pBt = p->pBt;
+  if( pBt->pPage1==0 ){
+    sqlite3BtreeLeave(p);
+    return SQLITE_ERROR;
+  }
+  if( version==FSS_DB_VERSION ){
+    rc = sqlite3BtreeMarkFss(pBt);
+  }else{
+    rc = sqlite3PagerWrite(pBt->pPage1->pDbPage);
+    if( rc==SQLITE_OK ){
+      if( version==0 ){
+        memset(pBt->pPage1->aData + FSS_DB_MARKER_OFFSET, 0, FSS_DB_MARKER_SIZE);
+        pBt->btsFlags &= ~BTS_FSS;
+      }else{
+        sqlite3FssWriteDbMarker(pBt->pPage1->aData, version);
+        pBt->btsFlags &= ~BTS_FSS;
+      }
+    }
+  }
+  sqlite3BtreeLeave(p);
+  return rc;
+}
+
+int sqlite3BtreeGetFssFormat(Btree *p){
+  BtShared *pBt;
+  int res = 0;
+  if( p==0 ) return 0;
+  sqlite3BtreeEnter(p);
+  pBt = p->pBt;
+  if( pBt && pBt->pPage1 && pBt->pPage1->aData ){
+    u32 ver = 0;
+    if( sqlite3FssValidateDbMarker(pBt->pPage1->aData, &ver) == FSS_MARKER_VALID ){
+      res = (int)ver;
+    }
+  }
+  sqlite3BtreeLeave(p);
+  return res;
+}
