+static int btreeValidateFssPage(MemPage *pPage){
+  u8 *pHdr = pPage->aData + pPage->hdrOffset;
+  u8 flags;
+  u16 schema_version, cell_count, capacity, row_payload_size;
+  u16 field_desc_offset, data_area_offset, reserved;
+  u16 nCols, descSize, calcPayloadSize, nullBytes;
+  u32 available, unitSize, expectedCapacity, expectedDataOffset;
+  u8 *pDesc;
+  u16 i;
+
+  if( pHdr[FSS_HDR_PAGE_TYPE] != PTF_FSS_LEAF ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+  flags = pHdr[FSS_HDR_FLAGS];
+  if( (flags & ~(FSS_FLAG_DENSE_ROWID | FSS_FLAG_NULLABLE)) != 0 ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+  schema_version = get2byte(&pHdr[FSS_HDR_SCHEMA_VERSION]);
+  if( schema_version != FSS_SCHEMA_VERSION ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+  cell_count = get2byte(&pHdr[FSS_HDR_CELL_COUNT]);
+  capacity = get2byte(&pHdr[FSS_HDR_CAPACITY]);
+  if( cell_count == 0 || capacity == 0 || cell_count > capacity ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+  row_payload_size = get2byte(&pHdr[FSS_HDR_ROW_PAYLOAD_SIZE]);
+  if( row_payload_size == 0 ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+  field_desc_offset = get2byte(&pHdr[FSS_HDR_FIELD_DESC_OFFSET]);
+  if( field_desc_offset != FSS_HEADER_SIZE ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+  data_area_offset = get2byte(&pHdr[FSS_HDR_DATA_AREA_OFFSET]);
+  reserved = get2byte(&pHdr[FSS_HDR_RESERVED]);
+  if( reserved != 0 ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+
+  /* Validate Schema Descriptors */
+  if( (u32)field_desc_offset + FSS_SCHEMA_HEADER_SIZE > (u32)(pPage->pBt->usableSize - pPage->hdrOffset) ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+  pDesc = pHdr + field_desc_offset;
+  nCols = get2byte(&pDesc[FSS_SCHEMA_NUM_COLUMNS]);
+  if( nCols == 0 || nCols > FSS_MAX_COLUMNS ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+  descSize = FSS_SCHEMA_HEADER_SIZE + nCols * FSS_FIELD_DESC_SIZE;
+  if( (u32)field_desc_offset + descSize > (u32)(pPage->pBt->usableSize - pPage->hdrOffset) ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+
+  calcPayloadSize = 0;
+  nullBytes = (flags & FSS_FLAG_NULLABLE) ? ((nCols + 7) / 8) : 0;
+  calcPayloadSize += nullBytes;
+  for( i = 0; i < nCols; i++ ){
+    u8 type_id = pDesc[FSS_SCHEMA_COLUMNS + i * FSS_FIELD_DESC_SIZE];
+    u8 col_flags = pDesc[FSS_SCHEMA_COLUMNS + i * FSS_FIELD_DESC_SIZE + 1];
+    u16 width = get2byte(&pDesc[FSS_SCHEMA_COLUMNS + i * FSS_FIELD_DESC_SIZE + 2]);
+    if( (col_flags & ~(FSS_COL_FLAG_NOT_NULL | FSS_COL_FLAG_PRIMARY_KEY)) != 0 ){
+      return SQLITE_CORRUPT_PAGE(pPage);
+    }
+    switch( type_id ){
+      case FSS_TYPE_INT8:        if( width != 1 ) return SQLITE_CORRUPT_PAGE(pPage); break;
+      case FSS_TYPE_INT16:       if( width != 2 ) return SQLITE_CORRUPT_PAGE(pPage); break;
+      case FSS_TYPE_INT32:       if( width != 4 ) return SQLITE_CORRUPT_PAGE(pPage); break;
+      case FSS_TYPE_INT64:       if( width != 8 ) return SQLITE_CORRUPT_PAGE(pPage); break;
+      case FSS_TYPE_FLOAT32:     if( width != 4 ) return SQLITE_CORRUPT_PAGE(pPage); break;
+      case FSS_TYPE_FLOAT64:     if( width != 8 ) return SQLITE_CORRUPT_PAGE(pPage); break;
+      case FSS_TYPE_FIXED_BLOB:  if( width == 0 ) return SQLITE_CORRUPT_PAGE(pPage); break;
+      case FSS_TYPE_TIMESTAMP_US:if( width != 8 ) return SQLITE_CORRUPT_PAGE(pPage); break;
+      default: return SQLITE_CORRUPT_PAGE(pPage);
+    }
+    calcPayloadSize += width;
+  }
+  if( calcPayloadSize != row_payload_size ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+
+  /* Validate Capacity & Offsets */
+  available = pPage->pBt->usableSize - pPage->hdrOffset - FSS_HEADER_SIZE - descSize;
+  if( flags & FSS_FLAG_DENSE_ROWID ){
+    if( available < 8 ) return SQLITE_CORRUPT_PAGE(pPage);
+    available -= 8;
+    unitSize = row_payload_size;
+  }else{
+    unitSize = row_payload_size + 8;
+  }
+  if( unitSize == 0 ) return SQLITE_CORRUPT_PAGE(pPage);
+  expectedCapacity = available / unitSize;
+  if( expectedCapacity > UINT16_MAX ) expectedCapacity = UINT16_MAX;
+  if( expectedCapacity == 0 || (u16)expectedCapacity != capacity ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+
+  expectedDataOffset = FSS_HEADER_SIZE + descSize + ((flags & FSS_FLAG_DENSE_ROWID) ? 8 : (8 * capacity));
+  if( expectedDataOffset > UINT16_MAX || (u16)expectedDataOffset != data_area_offset ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+  if( (u32)pPage->hdrOffset + data_area_offset + (u32)cell_count * row_payload_size > (u32)pPage->pBt->usableSize ){
+    return SQLITE_CORRUPT_PAGE(pPage);
+  }
+
+  /* Validate Rowids */
+  if( flags & FSS_FLAG_DENSE_ROWID ){
+    i64 minRowid = fssGetRowid(pPage, 0);
+    if( minRowid > INT64_MAX - (i64)(cell_count - 1) ){
+      return SQLITE_CORRUPT_PAGE(pPage);
+    }
+  }else{
+    i64 prev = fssGetRowid(pPage, 0);
+    for( i = 1; i < cell_count; i++ ){
+      i64 curr = fssGetRowid(pPage, i);
+      if( curr <= prev ){
+        return SQLITE_CORRUPT_PAGE(pPage);
+      }
+      prev = curr;
+    }
+    for( i = cell_count; i < capacity; i++ ){
+      if( fssGetRowid(pPage, i) != 0 ){
+        return SQLITE_CORRUPT_PAGE(pPage);
+      }
+    }
+  }
+
+  return SQLITE_OK;
+}
