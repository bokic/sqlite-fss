+     || (len==4 && sqlite3_strnicmp(zType, "BOOL", 4)==0)
+     || (len==7 && sqlite3_strnicmp(zType, "BOOLEAN", 7)==0) ){
+      type_id = FSS_TYPE_INT8;
+      width = 1;
+    }else if( len==5 && sqlite3_strnicmp(zType, "INT16", 5)==0 ){
+      type_id = FSS_TYPE_INT16;
+      width = 2;
+    }else if( len==5 && sqlite3_strnicmp(zType, "INT32", 5)==0 ){
+      type_id = FSS_TYPE_INT32;
+      width = 4;
+    }else if( (len==3 && sqlite3_strnicmp(zType, "INT", 3)==0)
+           || (len==7 && sqlite3_strnicmp(zType, "INTEGER", 7)==0)
+           || (len==6 && sqlite3_strnicmp(zType, "BIGINT", 6)==0)
+           || (len==5 && sqlite3_strnicmp(zType, "INT64", 5)==0) ){
+      type_id = FSS_TYPE_INT64;
+      width = 8;
+    }else if( (len==7 && sqlite3_strnicmp(zType, "FLOAT64", 7)==0)
+           || (len==6 && sqlite3_strnicmp(zType, "DOUBLE", 6)==0)
+           || (len==4 && sqlite3_strnicmp(zType, "REAL", 4)==0) ){
+      type_id = FSS_TYPE_FLOAT64;
+      width = 8;
+    }else if( len==12 && sqlite3_strnicmp(zType, "TIMESTAMP_US", 12)==0 ){
+      type_id = FSS_TYPE_TIMESTAMP_US;
+      width = 8;
+    }else if( len>6 && sqlite3_strnicmp(zType, "BLOB(", 5)==0 && zType[len-1]==')' ){
